{
  "name": "hell-llex_bot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "nodemon --legacy-watch --watch src --exec \"node --env-file=.env\" src/main.js",
    "dev:docker": "docker compose -f docker-compose.dev.yml up --build",
    "dev:docker:down": "docker compose -f docker-compose.dev.yml down",
    "start": "node --env-file=.env src/main.js",
    "build:image": "node scripts/build-docker-image.mjs"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "dependencies": {
    "@dietime/telegraf-media-group": "^1.0.5",
    "telegraf": "^4.16.3"
  }
}
