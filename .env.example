# host path -> mounted as /vault in container
VAULT_PATH=C:/path/to/vault

# where bot writes notes inside container
INBOX_DIR_NOTES=/vault/Notes
INBOX_DIR_FORWARD=/vault/Telegram

DATA_ROOT=/app/data
TMP_DIR=/app/data/tmp
DATA_DISPLAY_ROOT=data

# min | mid | max
PHOTO_DOWNLOAD_SIZE=min

BOT_TOKEN=put_bot_token_here
ADMIN_USER_ID=0

# Telegram forum topics routing.
# Enable topics, then bind them inside Telegram:
# /topic bind notes
# /topic bind monitoring
# /topic bind alerts
TOPICS_ENABLED=false
TOPIC_ROUTES_PATH=
BOT_SETTINGS_PATH=

# Optional static fallback routes. Runtime /topic bindings override these.
TOPIC_NOTES_THREAD_ID=
TOPIC_MONITORING_THREAD_ID=
TOPIC_ALERTS_THREAD_ID=
TOPIC_ADMIN_THREAD_ID=

TZ=Europe/Minsk
